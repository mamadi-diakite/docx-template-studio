{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/docx-template-studio.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "RootPath": "App_Data/files"
  },
  "Jwt": {
    "Issuer": "docx-template-studio",
    "Audience": "docx-template-studio",
    "AccessTokenMinutes": 60
  }
}
